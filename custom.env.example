# Copy to custom.env and chmod 600. Keep custom.env out of git.
# The container reads all of it; docker-compose.yml reads it too (through the .env symlink)
# for LETSWIFI_PUBLIC_IP. Write values without quotes; spaces are fine.

## Portal
# Public hostname; must resolve to LETSWIFI_PUBLIC_IP
LETSWIFI_HOSTNAME=lets.example.edu
# Host address to publish HTTPS (port 443) on
LETSWIFI_PUBLIC_IP=192.0.2.10
# Name shown on the portal
LETSWIFI_PORTAL_NAME=Example eduroam Support Organization Name
# "Learn more" link in the front page's "What is eduroam?" section; https://eduroam.org if empty
LETSWIFI_INFO_URL=
# SimpleSAMLphp's technical contact
LETSWIFI_SUPPORT_NAME=Example eduroam support
LETSWIFI_SUPPORT_EMAIL=support@example.edu
# Time zone for logs and SimpleSAMLphp (a tz database name)
TZ=America/Los_Angeles

## ACME: the portal's public TLS certificate
# Any ACME CA should work, but we tested with CERTInext (InCommon Certificate Service).
# Port 80 isn't used, so the CA must either pre-validate your domain (as CERTInext does once DCV for
# the parent domain is complete) or validate each order with TLS-ALPN-01 on port 443.
ACME_DIRECTORY_URL=https://acme-us.certinext.io/v1/directory
# External Account Binding (EAB) credentials from your CA. If your CA doesn't use EAB (e.g. Let's
# Encrypt), set ACME_EAB_KID=none and leave ACME_EAB_HMAC empty or httpd won't start.
ACME_EAB_KID=
ACME_EAB_HMAC=
# mod_md requires a contact address for ACME account registration
ACME_CONTACT_EMAIL=support@example.edu

## FreeRADIUS hosts allowed to pull revocation deny-lists from https://<hostname>/revocations/
# Must not be empty; use 127.0.0.1 if you need to block all hosts for some reason.
# Separate multiple entries with spaces, e.g. LETSWIFI_REVOCATION_CLIENTS=192.168.0.2 10.0.100.0/24
LETSWIFI_REVOCATION_CLIENTS=127.0.0.1
